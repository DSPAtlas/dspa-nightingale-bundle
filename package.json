{
  "name": "dspa-nightingale-bundle",
  "version": "1.0.0",
  "private": true,
  "description": "Reproducible builds of DSPAtlas Nightingale components",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "nightingale-sequence",
    "nightingale-sequence-heatmap",
    "nightingale-structure",
    "nightingale-track"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "jest --runInBand",
    "test:watch": "jest --watch"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "25.0.7",
    "@rollup/plugin-json": "6.1.0",
    "@rollup/plugin-node-resolve": "15.2.3",
    "@rollup/plugin-terser": "0.4.4",
    "@rollup/plugin-typescript": "11.1.6",
    "@types/d3": "7.4.3",
    "@types/jest": "29.5.12",
    "@types/lodash-es": "4.17.12",
    "@types/node": "20.12.11",
    "jest": "29.7.0",
    "rollup": "4.17.2",
    "rollup-plugin-css-only": "4.5.2",
    "ts-jest": "29.1.2",
    "tslib": "2.6.2",
    "typescript": "5.4.5"
  }
}
