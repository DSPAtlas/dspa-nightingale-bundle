{
  "compilerOptions": {
    "target": "es2019",
    "module": "ES2020",
    "moduleResolution": "node",
    "noEmitOnError": true,
    "declaration": true,
    "declarationMap": true,
    "lib": ["es2019", "dom"],
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "sourceMap": true,
    "inlineSources": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": false
  }
}
